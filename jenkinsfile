pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                script{
                    echo 'Build ansible'
                    sh 'ansible-playbook ansible/build.yml -i ansible/inventory/host.yml'
                }
            }
        }
        
        
    }
    post {
        success {
            echo 'Le déploiement a réussi!'
        }
        failure {
            echo 'Le déploiement a échoué.'
        }
    }
} 