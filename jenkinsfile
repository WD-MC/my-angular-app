pipeline {
    agent any
    tools {nodejs "NODEJS"}
    stages {
        stage('Check Node.js') {
            steps {
                sh 'node -v'
                sh 'which node'
                sh 'echo $PATH'
                
                    
            }
        }
        stage('Install Dependencies') {
            steps {
                echo 'Install Dependencies'
                sh 'npm install'
            }
        }
        stage('Unit Test') {
            steps {
                echo 'Unit test'
                timeout(time: 10, unit: 'MINUTES') {
                    sh 'npm run test -- --watch=false --browsers=ChromeHeadless'
                }
            }
        }
        stage('Build') {
            steps {
                sh 'ansible-playbook -v -i ansible/inventory/host.yml ansible/playbook.yml'
            }
        }
        
    }
    post {
        success {
            echo 'Le déploiement a réussi!'
        }
        failure {
            echo 'Le déploiement a échoué.'
        }
    }
}

