pipeline {
    agent any
    /*environment {
        VAULT_PASS = credentials('vault-password-id') 
    }*/
    tools {nodejs "NODEJS"}
    stages {
        stage('Install Dependencies') {
            steps {
                echo 'Install Dependencies'
                sh 'npm install'
            }
        }
        stage('Unit Test') {
            steps {
                echo 'Unit test'
                timeout(time: 10, unit: 'MINUTES') {
                    sh 'npm run test -- --watch=false --browsers=ChromeHeadless'
                }
            }
        }
        stage('Build') {
            steps {
                script {
                    // Créer un fichier temporaire pour le mot de passe
                    withCredentials([string(credentialsId: 'vault-password-id', variable: 'VAULT_PASS')]) {
                        writeFile file: 'vault_pass.txt', text: "${VAULT_PASS}"
                        // Utiliser le fichier temporaire avec Ansible
                        sh 'ansible-playbook -v -i ansible/inventory/host.yml ansible/playbook.yml --extra-vars @ansible/vault.yml --vault-password-file ansible/vault_pass.txt'
                    }
                }
                //sh 'ansible-playbook -v -i ansible/inventory/host.yml ansible/playbook.yml --extra-vars @ansible/vault.yml --vault-password-file vault_pass.txt'
            }
        }
    
        /*stage('Deploy') {
            steps {
                echo 'Deploy'
                sh 'chmod -R +rwx ./jenkins/scripts/deliver.sh'
                sh 'jenkins/scripts/deliver.sh'
                input message: 'Finibated using the web site? (Click "Proceed" to continue)'
            }
        }*/
        
    }
    post {
        success {
            echo 'Le déploiement a réussi!'
        }
        failure {
            echo 'Le déploiement a échoué.'
        }
    }
}